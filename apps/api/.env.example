PORT=4000
WEB_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://coddle:coddle@localhost:5432/coddle_learn
JWT_SECRET=dev-learn-jwt-secret-change-me
# Access JWT lifetime (minutes). Refresh cookie keeps you signed in longer.
JWT_ACCESS_EXPIRY_MINUTES=15
# Sliding refresh-token lifetime (days).
JWT_REFRESH_EXPIRY_DAYS=30


CODDLE_APP_URL=https://www.coddle.dev
CODDLE_API_URL=https://www.coddle.dev/api


LEARN_SSO_CLIENT_ID=coddle-learn
LEARN_SSO_CLIENT_SECRET=dev-learn-sso-secret-change-me
COOKIE_SECURE=false

# Content review: `auto` publishes on submit, `manual` waits for a reviewer.
REVIEW_MODE=manual

# Comma-separated emails promoted to reviewer (or admin) on sign-in.
LEARN_REVIEWER_EMAILS=
LEARN_ADMIN_EMAILS=

# Seeded courses are attributed to this Learn user (must already exist via SSO).
SEED_COURSE_CREATOR_EMAIL=you@example.com
SEED_MENTOR_EMAIL=you@example.com

# Cloudflare R2 (shared Coddle bucket; Learn objects under coddle-learn/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coddle
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.coddle.dev

# Learning assistant — Gemini only. Search ranking always runs in Learn.
# Set ASSISTANT_PROVIDER=search to return ranked hits without calling Gemini.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=4000
WEB_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://coddle:coddle@localhost:5432/coddle_learn
JWT_SECRET=dev-learn-jwt-secret-change-me
JWT_EXPIRY_HOURS=24
# Coddle web (login + /sso/learn bridge). Use https://www.coddle.dev in production.
CODDLE_APP_URL=http://localhost:3000
# Coddle API including /api/v1
# Match Coddle backend PORT (often 4002 in local .env.development)
CODDLE_API_URL=http://localhost:4002/api/v1
LEARN_SSO_CLIENT_ID=coddle-learn
LEARN_SSO_CLIENT_SECRET=dev-learn-sso-secret-change-me
COOKIE_SECURE=false

# Seeded courses are attributed to this Learn user (must already exist via SSO).
SEED_COURSE_CREATOR_EMAIL=you@example.com

# Cloudflare R2 (shared Coddle bucket; Learn objects under coddle-learn/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coddle
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.coddle.dev

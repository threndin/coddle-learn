generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  coddleUserId          String                   @unique @map("coddle_user_id")
  email                 String                   @unique
  username              String                   @unique
  name                  String
  /// learner | reviewer | admin. Reviewers moderate the content queue.
  role                  String                   @default("learner")
  avatarUrl             String?                  @map("avatar_url")
  bio                   String?
  experienceLevel       String?                  @map("experience_level")
  dailyGoalMinutes      Int?                     @map("daily_goal_minutes")
  practiceDays          String[]                 @default([]) @map("practice_days")
  startingRoadmapSlug   String?                  @map("starting_roadmap_slug")
  onboardingCompletedAt DateTime?                @map("onboarding_completed_at")
  points                Int                      @default(0)
  /// Public profile section visibility (profile editor).
  showRoadmapsPublic      Boolean                  @default(true) @map("show_roadmaps_public")
  showProjectsPublic      Boolean                  @default(true) @map("show_projects_public")
  showPostsPublic         Boolean                  @default(true) @map("show_posts_public")
  showSkillsPublic        Boolean                  @default(true) @map("show_skills_public")
  showCredentialsPublic   Boolean                  @default(true) @map("show_credentials_public")
  showAchievementsPublic  Boolean                  @default(true) @map("show_achievements_public")
  /// In-app notification group mutes (settings).
  notifyAccount           Boolean                  @default(true) @map("notify_account")
  notifyCommunity         Boolean                  @default(true) @map("notify_community")
  notifyLearning          Boolean                  @default(true) @map("notify_learning")
  notifyMentorship        Boolean                  @default(true) @map("notify_mentorship")
  notifyModeration        Boolean                  @default(true) @map("notify_moderation")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  lastLoginAt           DateTime?                @map("last_login_at")
  sessions              Session[]
  skills                UserSkill[]
  roadmaps              UserRoadmap[]
  stepProgress          UserStepProgress[]
  resourceBookmarks     UserResourceBookmark[]
  submittedResources    Resource[]               @relation("ResourceSubmitter")
  reviewedResources     Resource[]               @relation("ResourceReviewer")
  flaggedResources      Resource[]               @relation("ResourceFlagger")
  toolBookmarks         UserToolBookmark[]
  submittedTools        Tool[]                   @relation("ToolSubmitter")
  reviewedTools         Tool[]                   @relation("ToolReviewer")
  flaggedTools          Tool[]                   @relation("ToolFlagger")
  createdCourses        Course[]                 @relation("CourseCreator")
  reviewedCourses       Course[]                 @relation("CourseReviewer")
  flaggedCourses        Course[]                 @relation("CourseFlagger")
  courseEnrollments     UserCourse[]
  lessonProgress        UserLessonProgress[]
  exerciseSubmissions   UserExerciseSubmission[]
  courseReviews         CourseReview[]
  assessmentAttempts    AssessmentAttempt[]
  createdProjects       Project[]                @relation("ProjectCreator")
  reviewedProjects      Project[]                @relation("ProjectReviewer")
  flaggedProjects       Project[]                @relation("ProjectFlagger")
  projectSubmissions    ProjectSubmission[]
  credentials           Credential[]
  achievements          UserAchievement[]
  skillProgress         UserSkillProgress[]
  communityPosts             CommunityPost[]
  communityImpressions       CommunityPostImpression[]
  communityReactions         CommunityPostReaction[]
  communityComments          CommunityComment[]
  communityCommentReactions  CommunityCommentReaction[]
  communityReports           CommunityReport[]
  pointEvents                UserPointEvent[]
  following                  Follow[]                 @relation("UserFollowing")
  followers                  Follow[]                 @relation("UserFollowers")
  mentorProfile              MentorProfile?
  mentorshipApplications     MentorshipApplication[]  @relation("MenteeApplications")
  challengeSubmissions       ChallengeSubmission[]
  challengeSolves            ChallengeSolve[]
  notifications              Notification[]
  actedNotifications         Notification[]          @relation("NotificationActor")
  assistantWeeklyUsage       AssistantWeeklyUsage[]
  assistantConversations     AssistantConversation[]

  @@index([role])
  @@map("users")
}

/// One user following another. `follower` watches `following`.
model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

/// Append-only ledger of point awards and deductions.
model UserPointEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@index([refType, refId])
  @@map("user_point_events")
}

model Skill {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String
  category  String
  createdAt DateTime           @default(now()) @map("created_at")
  users     UserSkill[]
  courses   CourseSkill[]
  resources ResourceSkill[]
  projects  ProjectSkill[]
  tools     ToolSkill[]
  mentors   MentorProfileSkill[]
  edgesFrom SkillEdge[]        @relation("SkillEdgeFrom")
  edgesTo   SkillEdge[]        @relation("SkillEdgeTo")
  progress  UserSkillProgress[]

  @@map("skills")
}

/// Directed relationship between catalog skills (e.g. javascript → typescript).
model SkillEdge {
  id          String   @id @default(cuid())
  fromSkillId String   @map("from_skill_id")
  toSkillId   String   @map("to_skill_id")
  fromSkill   Skill    @relation("SkillEdgeFrom", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkill     Skill    @relation("SkillEdgeTo", fields: [toSkillId], references: [id], onDelete: Cascade)
  kind        String   @default("leads_to")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([fromSkillId, toSkillId])
  @@index([toSkillId])
  @@map("skill_edges")
}

/// Evidence-based proficiency. Onboarding interests stay on `UserSkill`.
/// Status: interested | learning | demonstrated | credentialed.
model UserSkillProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status    String
  evidence  Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, skillId])
  @@index([skillId])
  @@index([userId, status])
  @@map("user_skill_progress")
}

model UserSkill {
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Roadmap {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  level       String
  summary     String
  weeks       Int
  skillSlugs  String[]      @default([]) @map("skill_slugs")
  sortOrder   Int           @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  steps       RoadmapStep[]
  enrollments UserRoadmap[]
  projects    Project[]

  @@map("roadmaps")
}

model RoadmapStep {
  id               String                 @id @default(cuid())
  roadmapId        String                 @map("roadmap_id")
  roadmap          Roadmap                @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  summary          String
  estimatedMinutes Int                    @map("estimated_minutes")
  sortOrder        Int                    @map("sort_order")
  learnings        Json                   @default("[]")
  practice         String                 @default("")
  branchKey        String?                @map("branch_key")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  progress         UserStepProgress[]
  resources        RoadmapStepResource[]
  projects         Project[]

  @@unique([roadmapId, slug])
  @@index([roadmapId, sortOrder])
  @@map("roadmap_steps")
}

model UserRoadmap {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  roadmapId   String    @map("roadmap_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false) @map("is_primary")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([userId, roadmapId])
  @@index([roadmapId])
  @@index([userId, isPrimary])
  @@map("user_roadmaps")
}

model UserStepProgress {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  stepId        String      @map("step_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step          RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status        String
  pointsAwarded Int         @default(0) @map("points_awarded")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([userId, stepId])
  @@index([stepId])
  @@map("user_step_progress")
}

/// `url` is the normalized form from `normalizeResourceUrl`, so it doubles as the duplicate check.
/// `status`: pending | published | rejected. Seeded resources have no submitter.
model Resource {
  id                String                 @id @default(cuid())
  url               String                 @unique
  title             String
  description       String                 @default("")
  type              String
  level             String
  status            String                 @default("pending")
  submittedByUserId String?                @map("submitted_by_user_id")
  submittedBy       User?                  @relation("ResourceSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?              @map("reviewed_at")
  reviewedByUserId  String?                @map("reviewed_by_user_id")
  reviewedBy        User?                  @relation("ResourceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote        String?                @map("review_note")
  flaggedAt         DateTime?              @map("flagged_at")
  flaggedByUserId   String?                @map("flagged_by_user_id")
  flaggedBy         User?                  @relation("ResourceFlagger", fields: [flaggedByUserId], references: [id], onDelete: SetNull)
  flagNote          String?                @map("flag_note")
  publishedAt       DateTime?              @map("published_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  skills            ResourceSkill[]
  steps             RoadmapStepResource[]
  bookmarks         UserResourceBookmark[]

  @@index([status, publishedAt])
  @@index([submittedByUserId, createdAt])
  @@index([flaggedAt])
  @@index([reviewedByUserId])
  @@map("resources")
}

model ResourceSkill {
  resourceId String   @map("resource_id")
  skillId    String   @map("skill_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([resourceId, skillId])
  @@index([skillId])
  @@map("resource_skills")
}

model RoadmapStepResource {
  stepId     String      @map("step_id")
  resourceId String      @map("resource_id")
  step       RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  resource   Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sortOrder  Int         @map("sort_order")

  @@id([stepId, resourceId])
  @@index([resourceId])
  @@map("roadmap_step_resources")
}

model UserResourceBookmark {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  resourceId String   @map("resource_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@map("user_resource_bookmarks")
}

/// Community-submitted developer products. `url` is normalized like resources.
/// `status`: pending | published | rejected. Seeded tools have no submitter.
model Tool {
  id                String             @id @default(cuid())
  slug              String             @unique
  url               String             @unique
  title             String
  summary           String
  imageUrl          String             @map("image_url")
  category          String
  pricing           String
  platforms         String[]           @default([])
  status            String             @default("pending")
  submittedByUserId String?            @map("submitted_by_user_id")
  submittedBy       User?              @relation("ToolSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?          @map("reviewed_at")
  reviewedByUserId  String?            @map("reviewed_by_user_id")
  reviewedBy        User?              @relation("ToolReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote        String?            @map("review_note")
  flaggedAt         DateTime?          @map("flagged_at")
  flaggedByUserId   String?            @map("flagged_by_user_id")
  flaggedBy         User?              @relation("ToolFlagger", fields: [flaggedByUserId], references: [id], onDelete: SetNull)
  flagNote          String?            @map("flag_note")
  publishedAt       DateTime?          @map("published_at")
  sortOrder         Int                @default(100) @map("sort_order")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  skills            ToolSkill[]
  bookmarks         UserToolBookmark[]

  @@index([status, publishedAt])
  @@index([submittedByUserId, createdAt])
  @@index([category])
  @@index([sortOrder])
  @@index([flaggedAt])
  @@index([reviewedByUserId])
  @@map("tools")
}

model ToolSkill {
  toolId    String   @map("tool_id")
  skillId   String   @map("skill_id")
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([toolId, skillId])
  @@index([skillId])
  @@map("tool_skills")
}

model UserToolBookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  toolId    String   @map("tool_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, toolId])
  @@index([toolId])
  @@map("user_tool_bookmarks")
}

model Session {
  id               String   @id @default(cuid())
  jti              String   @unique
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model OAuthState {
  id         String    @id @default(cuid())
  jti        String    @unique
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("oauth_states")
}

/// Lifecycle: draft -> in_review -> (changes_requested -> in_review)* -> published <-> archived.
/// `reviewedBy*` and `reviewNote` are written by the moderation step (auto or admin).
model Course {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  summary          String
  level            String
  status           String         @default("draft")
  accent           String         @default("#004CC8")
  thumbnailUrl     String         @map("thumbnail_url")
  customThumbnail  Boolean        @default(false) @map("custom_thumbnail")
  estimatedHours   Int            @map("estimated_hours")
  sortOrder        Int            @default(100) @map("sort_order")
  submittedAt      DateTime?      @map("submitted_at")
  reviewedAt       DateTime?      @map("reviewed_at")
  reviewedByUserId String?        @map("reviewed_by_user_id")
  reviewedBy       User?          @relation("CourseReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote       String?        @map("review_note")
  flaggedAt        DateTime?      @map("flagged_at")
  flaggedByUserId  String?        @map("flagged_by_user_id")
  flaggedBy        User?          @relation("CourseFlagger", fields: [flaggedByUserId], references: [id], onDelete: SetNull)
  flagNote         String?        @map("flag_note")
  publishedAt      DateTime?      @map("published_at")
  createdByUserId  String         @map("created_by_user_id")
  createdBy        User           @relation("CourseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  modules          CourseModule[]
  skills           CourseSkill[]
  enrollments      UserCourse[]
  reviews          CourseReview[]
  assessment       Assessment?
  projects         Project[]

  @@index([createdByUserId])
  @@index([status, sortOrder])
  @@index([sortOrder])
  @@index([flaggedAt])
  @@map("courses")
}

/// One final assessment per course. Questions live in `AssessmentQuestion`.
model Assessment {
  id               String               @id @default(cuid())
  courseId         String               @unique @map("course_id")
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  summary          String               @default("")
  passPercent      Int                  @default(80) @map("pass_percent")
  timeLimitMinutes Int?                 @map("time_limit_minutes")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  questions        AssessmentQuestion[]
  attempts         AssessmentAttempt[]
  credentials      Credential[]

  @@map("assessments")
}

/// `kind`: multiple_choice | true_false | short_answer. `config` holds options / answers.
model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind         String
  prompt       String
  explanation  String     @default("")
  points       Int        @default(1)
  sortOrder    Int        @map("sort_order")
  config       Json       @default("{}")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([assessmentId, sortOrder])
  @@map("assessment_questions")
}

/// Append-only attempts. `status`: in_progress | submitted.
model AssessmentAttempt {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  assessmentId String     @map("assessment_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  status       String
  score        Int?
  passed       Boolean?
  answers      Json       @default("{}")
  results      Json?
  pointsEarned Int        @default(0) @map("points_earned")
  startedAt    DateTime      @default(now()) @map("started_at")
  submittedAt  DateTime?     @map("submitted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  credentials  Credential[]

  @@index([userId, assessmentId])
  @@index([assessmentId])
  @@map("assessment_attempts")
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  userId    String   @map("user_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, userId])
  @@index([courseId, createdAt])
  @@index([userId])
  @@map("course_reviews")
}

model CourseModule {
  id        String         @id @default(cuid())
  courseId  String         @map("course_id")
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  summary   String
  sortOrder Int            @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  lessons   CourseLesson[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id               String               @id @default(cuid())
  moduleId         String               @map("module_id")
  module           CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  summary          String
  content          String
  estimatedMinutes Int                  @map("estimated_minutes")
  sortOrder        Int                  @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  progress         UserLessonProgress[]
  exercises        CourseExercise[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

/// `kind`: task | link | text | quiz. `config` holds requirements and quiz questions.
model CourseExercise {
  id               String                   @id @default(cuid())
  lessonId         String                   @map("lesson_id")
  lesson           CourseLesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind             String
  title            String
  instructions     String                   @default("")
  hint             String                   @default("")
  solution         String                   @default("")
  config           Json                     @default("{}")
  estimatedMinutes Int                      @default(15) @map("estimated_minutes")
  sortOrder        Int                      @map("sort_order")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  submissions      UserExerciseSubmission[]

  @@index([lessonId, sortOrder])
  @@map("course_exercises")
}

/// `status`: completed | submitted | attempted (failed quiz, not done).
model UserExerciseSubmission {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  exerciseId    String         @map("exercise_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise      CourseExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  status        String
  response      Json           @default("{}")
  score         Int?
  attempts      Int            @default(1)
  pointsAwarded Int            @default(0) @map("points_awarded")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@map("user_exercise_submissions")
}

model CourseSkill {
  courseId  String   @map("course_id")
  skillId   String   @map("skill_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([courseId, skillId])
  @@index([skillId])
  @@map("course_skills")
}

model UserCourse {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("user_courses")
}

model UserLessonProgress {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  lessonId      String       @map("lesson_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status        String
  pointsAwarded Int          @default(0) @map("points_awarded")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("user_lesson_progress")
}

/// Lifecycle: draft -> in_review -> (changes_requested -> in_review)* -> published <-> archived.
/// Scoped to a roadmap (learning path). Optional step/course links are soft guides, not gates.
model Project {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  summary          String
  body             String              @default("")
  level            String
  checklist        String[]            @default([])
  exampleImageUrl  String?             @map("example_image_url")
  primarySkillSlug String              @map("primary_skill_slug")
  estimatedHours   Int                 @default(2) @map("estimated_hours")
  status           String              @default("draft")
  sortOrder        Int                 @default(100) @map("sort_order")
  roadmapId        String              @map("roadmap_id")
  roadmap          Roadmap             @relation(fields: [roadmapId], references: [id], onDelete: Restrict)
  roadmapStepId    String?             @map("roadmap_step_id")
  roadmapStep      RoadmapStep?        @relation(fields: [roadmapStepId], references: [id], onDelete: SetNull)
  courseId         String?             @map("course_id")
  course           Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  submittedAt      DateTime?           @map("submitted_at")
  reviewedAt       DateTime?           @map("reviewed_at")
  reviewedByUserId String?             @map("reviewed_by_user_id")
  reviewedBy       User?               @relation("ProjectReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote       String?             @map("review_note")
  flaggedAt        DateTime?           @map("flagged_at")
  flaggedByUserId  String?             @map("flagged_by_user_id")
  flaggedBy        User?               @relation("ProjectFlagger", fields: [flaggedByUserId], references: [id], onDelete: SetNull)
  flagNote         String?             @map("flag_note")
  publishedAt      DateTime?           @map("published_at")
  createdByUserId  String              @map("created_by_user_id")
  createdBy        User                @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  skills           ProjectSkill[]
  submissions      ProjectSubmission[]
  credentials      Credential[]

  @@index([createdByUserId])
  @@index([roadmapId, status, sortOrder])
  @@index([status, sortOrder])
  @@index([roadmapStepId])
  @@index([courseId])
  @@index([flaggedAt])
  @@map("projects")
}

model ProjectSkill {
  projectId String   @map("project_id")
  skillId   String   @map("skill_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_skills")
}

/// `status`: started | submitted. One row per learner per project brief.
model ProjectSubmission {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  userId        String    @map("user_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String
  repoUrl       String?   @map("repo_url")
  liveUrl       String?   @map("live_url")
  notes         String    @default("")
  pointsAwarded Int       @default(0) @map("points_awarded")
  startedAt     DateTime  @default(now()) @map("started_at")
  submittedAt   DateTime? @map("submitted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  credentials   Credential[]

  @@unique([userId, projectId])
  @@index([projectId, status])
  @@index([userId, status, updatedAt])
  @@map("project_submissions")
}

/// Free, verifiable proof. `kind`: assessment | project.
/// `code` is the public verification token; `id` is the owner detail URL.
model Credential {
  id                   String              @id @default(cuid())
  code                 String              @unique
  userId               String              @map("user_id")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                 String
  title                String
  summary              String              @default("")
  assessmentId         String?             @map("assessment_id")
  assessment           Assessment?         @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  assessmentAttemptId  String?             @map("assessment_attempt_id")
  assessmentAttempt    AssessmentAttempt?  @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  projectId            String?             @map("project_id")
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectSubmissionId  String?             @map("project_submission_id")
  projectSubmission    ProjectSubmission?  @relation(fields: [projectSubmissionId], references: [id], onDelete: SetNull)
  issuedAt             DateTime            @default(now()) @map("issued_at")

  @@unique([userId, assessmentId])
  @@unique([userId, projectId])
  @@index([userId, issuedAt])
  @@index([kind])
  @@map("credentials")
}

/// Awarded milestones. Definitions live in `@coddle/shared`; this table stores earns only.
/// `slug` matches `ACHIEVEMENT_SLUGS` (e.g. first-course, streak-7).
model UserAchievement {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  earnedAt  DateTime @default(now()) @map("earned_at")

  @@unique([userId, slug])
  @@index([userId, earnedAt])
  @@index([slug])
  @@map("user_achievements")
}

/// Community feed. `kind`: question | discussion | project_share.
/// `topic`: general | course | roadmap | project.
/// Comments are two levels: top-level on the post, then replies to those only.
/// `quotePostId` embeds another post X-style (quote post).
model CommunityPost {
  id              String                    @id @default(cuid())
  authorId        String                    @map("author_id")
  author          User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  slug            String                    @unique
  kind            String
  topic           String                    @default("general")
  relatedSlug     String?                   @map("related_slug")
  relatedTitle    String?                   @map("related_title")
  title           String
  body            String
  imageUrls       String[]                  @default([]) @map("image_urls")
  quotePostId     String?                   @map("quote_post_id")
  quotePost       CommunityPost?            @relation("CommunityPostQuote", fields: [quotePostId], references: [id], onDelete: SetNull)
  quotes          CommunityPost[]           @relation("CommunityPostQuote")
  impressionCount Int                       @default(0) @map("impression_count")
  commentCount    Int                       @default(0) @map("comment_count")
  isDeleted       Boolean                   @default(false) @map("is_deleted")
  deletedAt       DateTime?                 @map("deleted_at")
  editedAt        DateTime?                 @map("edited_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  impressions     CommunityPostImpression[]
  reactions       CommunityPostReaction[]
  comments        CommunityComment[]
  reports         CommunityReport[]

  @@index([createdAt])
  @@index([isDeleted, createdAt])
  @@index([kind, createdAt])
  @@index([topic, createdAt])
  @@index([authorId, createdAt])
  @@index([quotePostId])
  @@map("community_posts")
}

/// Top-level comments on a post, or replies when `parentId` points at a top-level comment.
model CommunityComment {
  id        String                    @id @default(cuid())
  postId    String                    @map("post_id")
  post      CommunityPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String                    @map("author_id")
  author    User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?                   @map("parent_id")
  parent    CommunityComment?         @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[]        @relation("CommentThread")
  body      String
  isDeleted Boolean                   @default(false) @map("is_deleted")
  deletedAt DateTime?                 @map("deleted_at")
  editedAt  DateTime?                 @map("edited_at")
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")
  reactions CommunityCommentReaction[]
  reports   CommunityReport[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_comments")
}

/// Moderation reports for posts or comments. One report per reporter per target.
model CommunityReport {
  id         String           @id @default(cuid())
  reporterId String           @map("reporter_id")
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?          @map("post_id")
  post       CommunityPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?          @map("comment_id")
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     String           @default("pending")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("community_reports")
}

/// One reaction per user per comment. Same emoji vocabulary as posts.
model CommunityCommentReaction {
  id        String           @id @default(cuid())
  commentId String           @map("comment_id")
  comment   CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([commentId, userId])
  @@index([commentId, emoji])
  @@index([userId])
  @@map("community_comment_reactions")
}

/// Unique viewer per post. Drives `CommunityPost.impressionCount`.
model CommunityPostImpression {
  id        String        @id @default(cuid())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_post_impressions")
}

/// One reaction per user per post. `emoji` is a COMMUNITY_REACTION_EMOJIS value.
model CommunityPostReaction {
  id        String        @id @default(cuid())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([postId, userId])
  @@index([postId, emoji])
  @@index([userId])
  @@map("community_post_reactions")
}

/// Public mentor listing. One profile per user.
/// `availability`: open | limited | waitlist | paused.
model MentorProfile {
  id              String               @id @default(cuid())
  userId          String               @unique @map("user_id")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String
  about           String               @default("")
  experienceYears Int?                 @map("experience_years")
  availability    String
  timezone        String?
  topics          String[]             @default([])
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  skills          MentorProfileSkill[]
  programs        MentorshipProgram[]

  @@index([availability, createdAt])
  @@map("mentor_profiles")
}

model MentorProfileSkill {
  mentorProfileId String        @map("mentor_profile_id")
  skillId         String        @map("skill_id")
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@id([mentorProfileId, skillId])
  @@index([skillId])
  @@map("mentor_profile_skills")
}

/// A mentor-offered program. Learners apply; the mentor approves who joins.
/// `kind` matches MENTOR_TOPICS. `status`: open | closed | archived.
model MentorshipProgram {
  id              String                   @id @default(cuid())
  mentorProfileId String                   @map("mentor_profile_id")
  mentorProfile   MentorProfile            @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  summary         String
  description     String                   @default("")
  kind            String
  capacity        Int?
  durationWeeks   Int?                     @map("duration_weeks")
  status          String                   @default("open")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  applications    MentorshipApplication[]

  @@unique([mentorProfileId, slug])
  @@index([mentorProfileId, status])
  @@index([kind, status])
  @@map("mentorship_programs")
}

/// `status`: pending | approved | declined | withdrawn | completed.
model MentorshipApplication {
  id          String            @id @default(cuid())
  programId   String            @map("program_id")
  program     MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  menteeId    String            @map("mentee_id")
  mentee      User              @relation("MenteeApplications", fields: [menteeId], references: [id], onDelete: Cascade)
  message     String
  goals       String            @default("")
  status      String            @default("pending")
  mentorNote  String?           @map("mentor_note")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  reviewedAt  DateTime?         @map("reviewed_at")
  completedAt DateTime?         @map("completed_at")

  @@unique([programId, menteeId])
  @@index([menteeId, status, createdAt])
  @@index([programId, status])
  @@map("mentorship_applications")
}

/// Competitive coding problem. `difficulty`: easy | medium | hard.
/// `examples` are public. `tests` stay on the server.
model Challenge {
  id           String                @id @default(cuid())
  slug         String                @unique
  title        String
  summary      String
  statement    String
  difficulty   String
  language     String                @default("javascript")
  functionName String                @map("function_name")
  starterCode  String                @map("starter_code")
  points       Int
  examples     Json
  tests        Json
  sortOrder    Int                   @map("sort_order")
  published    Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  submissions  ChallengeSubmission[]
  solves       ChallengeSolve[]

  @@index([published, sortOrder])
  @@map("challenges")
}

/// One run of a learner's solution. `status`: passed | failed.
model ChallengeSubmission {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  challengeId  String          @map("challenge_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge    Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code         String
  status       String
  testsPassed  Int             @map("tests_passed")
  testsTotal   Int             @map("tests_total")
  runtimeError String?         @map("runtime_error")
  results      Json            @default("[]")
  createdAt    DateTime        @default(now()) @map("created_at")
  solve        ChallengeSolve?

  @@index([userId, challengeId, createdAt])
  @@index([challengeId, createdAt])
  @@map("challenge_submissions")
}

/// First passing solution. Rank and points are locked in at solve time.
model ChallengeSolve {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  challengeId   String              @map("challenge_id")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge     Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submissionId  String              @unique @map("submission_id")
  submission    ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attempts      Int
  rank          Int
  basePoints    Int                 @map("base_points")
  rankBonus     Int                 @map("rank_bonus")
  pointsAwarded Int                 @map("points_awarded")
  solvedAt      DateTime            @default(now()) @map("solved_at")

  @@unique([userId, challengeId])
  @@index([challengeId, rank])
  @@index([userId])
  @@map("challenge_solves")
}

/// In-app inbox. `type` matches NOTIFICATION_TYPES in `@coddle/shared`.
/// `dedupeKey` is optional; when set, the same event updates instead of duplicating.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  actorId   String?   @map("actor_id")
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  refType   String?   @map("ref_type")
  refId     String?   @map("ref_id")
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, type])
  @@index([actorId])
  @@map("notifications")
}

/// Assistant chat sends used in a UTC week. Catalog `/search` is not counted.
model AssistantWeeklyUsage {
  userId    String   @map("user_id")
  weekStart DateTime @map("week_start")
  used      Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekStart])
  @@map("assistant_weekly_usage")
}

/// One assistant thread. Always scoped to `userId` (session.sub).
model AssistantConversation {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String                 @id @default(cuid())
  conversationId String                 @map("conversation_id")
  conversation   AssistantConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String                 @db.Text
  hits           Json                   @default("[]")
  followUps      String[]               @default([]) @map("follow_ups")
  provider       String?
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

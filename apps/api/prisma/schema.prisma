generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  coddleUserId          String                 @unique @map("coddle_user_id")
  email                 String                 @unique
  name                  String
  avatarUrl             String?                @map("avatar_url")
  bio                   String?
  experienceLevel       String?                @map("experience_level")
  dailyGoalMinutes      Int?                   @map("daily_goal_minutes")
  practiceDays          String[]               @default([]) @map("practice_days")
  startingRoadmapSlug   String?                @map("starting_roadmap_slug")
  onboardingCompletedAt DateTime?              @map("onboarding_completed_at")
  points                Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  lastLoginAt           DateTime?              @map("last_login_at")
  sessions              Session[]
  skills                UserSkill[]
  roadmaps              UserRoadmap[]
  stepProgress          UserStepProgress[]
  resourceBookmarks     UserResourceBookmark[]
  createdCourses        Course[]               @relation("CourseCreator")
  reviewedCourses       Course[]               @relation("CourseReviewer")
  courseEnrollments     UserCourse[]
  lessonProgress        UserLessonProgress[]
  courseReviews         CourseReview[]

  @@map("users")
}

model Skill {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  category  String
  createdAt DateTime      @default(now()) @map("created_at")
  users     UserSkill[]
  courses   CourseSkill[]

  @@map("skills")
}

model UserSkill {
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Roadmap {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  level       String
  summary     String
  weeks       Int
  skillSlugs  String[]      @default([]) @map("skill_slugs")
  sortOrder   Int           @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  steps       RoadmapStep[]
  enrollments UserRoadmap[]

  @@map("roadmaps")
}

model RoadmapStep {
  id               String                 @id @default(cuid())
  roadmapId        String                 @map("roadmap_id")
  roadmap          Roadmap                @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  summary          String
  estimatedMinutes Int                    @map("estimated_minutes")
  sortOrder        Int                    @map("sort_order")
  learnings        Json                   @default("[]")
  practice         String                 @default("")
  branchKey        String?                @map("branch_key")
  resources        Json                   @default("[]")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  progress         UserStepProgress[]
  bookmarks        UserResourceBookmark[]

  @@unique([roadmapId, slug])
  @@index([roadmapId, sortOrder])
  @@map("roadmap_steps")
}

model UserRoadmap {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  roadmapId   String    @map("roadmap_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false) @map("is_primary")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([userId, roadmapId])
  @@index([roadmapId])
  @@index([userId, isPrimary])
  @@map("user_roadmaps")
}

model UserStepProgress {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  stepId        String      @map("step_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step          RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status        String
  pointsAwarded Int         @default(0) @map("points_awarded")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([userId, stepId])
  @@index([stepId])
  @@map("user_step_progress")
}

model UserResourceBookmark {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  stepId    String      @map("step_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  url       String
  title     String
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([userId, stepId, url])
  @@index([stepId])
  @@map("user_resource_bookmarks")
}

model Session {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model OAuthState {
  id         String    @id @default(cuid())
  jti        String    @unique
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("oauth_states")
}

/// Lifecycle: draft -> in_review -> (changes_requested -> in_review)* -> published <-> archived.
/// `reviewedBy*` and `reviewNote` are written by the moderation step (auto or admin).
model Course {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  summary          String
  level            String
  status           String         @default("draft")
  accent           String         @default("#004CC8")
  thumbnailUrl     String         @map("thumbnail_url")
  customThumbnail  Boolean        @default(false) @map("custom_thumbnail")
  estimatedHours   Int            @map("estimated_hours")
  sortOrder        Int            @default(100) @map("sort_order")
  submittedAt      DateTime?      @map("submitted_at")
  reviewedAt       DateTime?      @map("reviewed_at")
  reviewedByUserId String?        @map("reviewed_by_user_id")
  reviewedBy       User?          @relation("CourseReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote       String?        @map("review_note")
  publishedAt      DateTime?      @map("published_at")
  createdByUserId  String         @map("created_by_user_id")
  createdBy        User           @relation("CourseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  modules          CourseModule[]
  skills           CourseSkill[]
  enrollments      UserCourse[]
  reviews          CourseReview[]

  @@index([createdByUserId])
  @@index([status, sortOrder])
  @@index([sortOrder])
  @@map("courses")
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  userId    String   @map("user_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, userId])
  @@index([courseId, createdAt])
  @@index([userId])
  @@map("course_reviews")
}

model CourseModule {
  id        String         @id @default(cuid())
  courseId  String         @map("course_id")
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  summary   String
  sortOrder Int            @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  lessons   CourseLesson[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id               String               @id @default(cuid())
  moduleId         String               @map("module_id")
  module           CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  summary          String
  content          String
  estimatedMinutes Int                  @map("estimated_minutes")
  sortOrder        Int                  @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  progress         UserLessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model CourseSkill {
  courseId  String   @map("course_id")
  skillId   String   @map("skill_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([courseId, skillId])
  @@index([skillId])
  @@map("course_skills")
}

model UserCourse {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("user_courses")
}

model UserLessonProgress {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  lessonId      String       @map("lesson_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status        String
  pointsAwarded Int          @default(0) @map("points_awarded")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("user_lesson_progress")
}
